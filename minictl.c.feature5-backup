#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/socket.h>
#include <sys/un.h>
#include <unistd.h>

#define SOCKET_PATH "/tmp/minisystemd.sock"

int main(int argc, char *argv[]) {
    if (argc < 2) {
        printf("Usage: ./minictl <command>\n");
        printf("Available commands:\n");
        printf("  status    - Check daemon and service states\n");
        return 1;
    }

    // 1. Create a Unix Domain Socket
    int sock = socket(AF_UNIX, SOCK_STREAM, 0);
    if (sock < 0) {
        perror("Socket creation failed");
        return 1;
    }

    struct sockaddr_un addr;
    memset(&addr, 0, sizeof(addr));
    addr.sun_family = AF_UNIX;
    strncpy(addr.sun_path, SOCKET_PATH, sizeof(addr.sun_path) - 1);

    // 2. Connect to the running mini-systemd daemon
    if (connect(sock, (struct sockaddr*)&addr, sizeof(addr)) < 0) {
        perror("Failed to connect to mini-systemd daemon. Is the daemon running?");
        close(sock);
        return 1;
    }

    // 3. Send command to daemon
    write(sock, argv[1], strlen(argv[1]) + 1);

    // 4. Read response from daemon
    char buffer[256];
    int n = read(sock, buffer, sizeof(buffer) - 1);
    if (n > 0) {
        buffer[n] = '\0';
        printf("[minictl response] %s\n", buffer);
    }

    close(sock);
    return 0;
}
